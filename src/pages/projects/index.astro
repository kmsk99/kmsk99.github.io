---
import ListPage from '../../components/ListPage.astro';
import { getAllItems } from '../../lib/content';

const items = (await getAllItems()).filter((i) => i.kind === 'project');
---

<ListPage
	title="프로젝트"
	heading="프로젝트"
	lede="회사에서는 핏브릿지, 사장링크, 퍼프존·스쿨밋·아이러브클럽을 만들었습니다. 여기에는 직접 배포한 오픈소스 라이브러리와 도구를 모았습니다."
	items={items}
>
	<p style="font-size: 1rem; margin-top: 12px">
		<a class="text-link" href="/about/">회사 프로젝트와 담당 범위</a>
		<span aria-hidden="true">&nbsp;·&nbsp;</span>
		<a class="text-link" href="/documents/mason-kim-portfolio.pdf">포트폴리오 PDF</a>
	</p>
</ListPage>

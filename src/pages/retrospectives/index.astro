---
import ListPage from '../../components/ListPage.astro';
import { getAllItems } from '../../lib/content';

const items = (await getAllItems()).filter((i) => i.kind === 'retro');
---

<ListPage
	title="창업 회고"
	heading="창업 회고"
	lede="공동창업자를 찾고, 투자를 받고, 외주 프로젝트에서 실패한 이야기입니다. 기술보다 사람과 결정에 관한 기록입니다."
	items={items}
/>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const chev = '<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';

const roles = [
	{
		tone: 'product',
		org: '제이에이치핏',
		title: 'CTO',
		when: '2026.07–현재',
		sub: '2026.04부터 외주로 참여 · 피트니스 센터 운영 SaaS 핏브릿지',
		open: true,
		lede: '피트니스·필라테스·PT 센터 운영 SaaS 핏브릿지의 제품 개발을 맡고 있습니다. 센터 관리자 웹, 플랫폼 운영 백오피스, 회원·코치용 Flutter 앱이 하나의 NestJS API와 데이터 모델을 공유합니다.',
		points: [
			'회원·강사·수강권·예약·결제·급여 정산과 상담, 운동·식단·건강 기록까지 이어지는 업무 규칙 정리',
			'기존 센터의 회원·수강권 데이터 이관과 권한·정합성·예약 동시성 검증',
			'API 계약에서 OpenAPI·Dart 클라이언트를 생성하고, AWS ECS/Fargate·Terraform·GitHub Actions 배포와 Sentry 오류 추적 연결',
			'업무 개념·관계·규칙을 Turtle/OWL·SHACL·SPARQL로 표현하고 코드·DB·테스트 근거와 연결',
			'환불·리워드·인증의 동시성과 원자성 오류를 실제 PostgreSQL 경합과 장애 주입으로 재현해 수정',
			'인바디 결과지 추출을 항목별로 평가해 자주 틀리는 영역은 자동 입력에서 빼고, 사용자 확인·수정·수동 입력 경로 구성',
		],
		note: '선택한 금액 구간의 변이 탐지율은 59/73에서 71/73으로 올라갔습니다.',
	},
	{
		tone: 'data',
		org: '콘치즈',
		title: '개발팀장',
		when: '2026.03–2026.06',
		sub: '고용 법인 주식회사 씨씨에스 · 사장링크와 전산 업무 자동화',
		open: false,
		lede: '소상공인이 판매와 손익을 한 화면에서 확인하는 사장링크를 개발하고, 손으로 하던 전산 업무를 자동화했습니다. 고객 인터뷰를 진행한 기획자와 회의하며 매장 운영에 필요한 기능을 구체화했습니다.',
		points: [
			'POS·배달 매출, 홈택스 매입, 법인카드, 세무 전표를 연결해 판매 분석과 회계 손익·배달 손익을 분리',
			'손익 요약에서 매출·비용·전표 상세로 내려가는 조회 흐름과 모바일 리포트 개선',
			'실제 매장 자료와 대조해 데이터 누락, 동기화 차이, 미확정 전표, 수집 실패가 0원으로 보이던 문제 정리',
			'기업마당·K-스타트업 공고를 매일 오전 9시에 수집해 법인별 검토 카드로 만드는 장부 구축',
			'네이버 플레이스·배달 플랫폼·POS 수집 워커와 작업 큐, 장애 대응·인수인계 문서 정리',
		],
		note: '2026년 4월 배포 당시 공고 약 80개, 검토 카드 약 130개를 처음 적재했습니다.',
	},
	{
		tone: 'arch',
		org: '포트존',
		title: 'CTO',
		when: '2023.05–2026.03',
		sub: '사업은 2023.01 시작 · 4인 제품 개발팀 · 서비스 3개',
		open: false,
		lede: '4인 제품 개발팀을 이끌며 웹·모바일 서비스 3개를 개발하고 운영했습니다. 고객·기획자와의 회의를 바탕으로 기술을 결정하고, 채용·협업·운영에 필요한 문서를 정리했습니다.',
		points: [
			'퍼프존(글로벌 흡연구역 지도): 2개월 만에 MVP 출시, 사용자 3,000명 이상. 5개 언어와 실시간 번역, 지도 클러스터링, 위치정보 로그 설계',
			'스쿨밋(학력 인증 소셜 네트워크): 웹 MVP 3개월·앱 2개월, 누적 가입자 13,000명 이상. AWS KMS 문서 암호화, OCR+LLM 자동 인증으로 수동 검수 90% 이상 감소',
			'아이러브클럽(동아리 행정 플랫폼): 예약·승인과 카카오톡·이메일·푸시 알림 통합. GitHub Actions·Docker로 7분 안에 배포·롤백, Elastic Beanstalk에서 ECS/Fargate로 이전',
		],
		note: '서비스 전체 누적 가입자는 22,000명 이상입니다. 사용자 수와 검수 감소 수치는 2026년 3월 이력서 기준이며, 누적 가입자는 월간 활성 사용자와 다릅니다.',
	},
	{
		tone: 'retro',
		org: '대한민국 육군',
		title: '중위 · 화생방 소대장',
		when: '2019–2021',
		sub: '30명 규모 소대 지휘',
		open: false,
		lede: '30명 규모 소대를 지휘하며 훈련을 계획하고 운영했습니다.',
		points: [],
		note: '',
	},
];

const stack = [
	{ k: '웹·모바일', v: ['TypeScript', 'React', 'Next.js', 'TanStack Start', 'Flutter', 'React Native', 'Expo'] },
	{ k: '백엔드·데이터', v: ['NestJS', 'Node.js', 'Prisma', 'PostgreSQL', 'Supabase', 'GraphQL', 'API 계약'] },
	{ k: '인프라·운영', v: ['AWS ECS/Fargate', 'S3', 'CloudFront', 'KMS', 'Docker', 'Terraform', 'GitHub Actions', 'Sentry'] },
	{ k: 'AI·연구', v: ['Python', 'RAG', 'Reranking', 'Program-of-Thought', 'SFT·RL 평가', 'OCR+LLM'] },
	{ k: '규칙·검증', v: ['Turtle/OWL', 'SHACL', 'SPARQL', '모델 기반 테스트', '속성 기반 테스트', '변이 테스트', 'Playwright'] },
];

const principles = [
	{ t: '요구를 규칙으로 나눕니다', d: '고객과 기획자의 회의에서 나온 요구를 데이터, 업무 규칙, 구현 범위로 쪼개고 결정의 근거를 기록에 남깁니다.' },
	{ t: '실제 데이터로 확인합니다', d: '화면의 숫자는 원천 자료와 대조하고, 동시성 문제는 실제 DB 경합으로 재현합니다. 테스트 통과만으로 끝내지 않습니다.' },
	{ t: 'AI에게는 검증 장치를 붙입니다', d: 'AI가 만든 구현을 업무 규칙과 실행 결과에 대조하는 하네스를 둡니다. 규칙마다 근거와 변경 감지를 연결합니다.' },
	{ t: '자동 입력엔 사람이 고칠 길을 둡니다', d: '추출 모델은 항목별로 평가하고, 믿기 어려운 항목은 사용자가 확인하고 고칠 수 있게 만듭니다.' },
];

const facts = [
	{ k: 'LG Aimers AI 해커톤 우수상', v: '2022' },
	{ k: '빅데이터 스타트업 경진대회 특별상', v: '2022' },
	{ k: '정보처리기사', v: '2021' },
	{ k: '데이터분석 준전문가(ADsP)', v: '2022' },
	{ k: '화공기사', v: '2019' },
	{ k: '서울과학기술대학교 화공생명공학과 졸업', v: '2019' },
];

const sides = [
	{ href: 'https://github.com/kmsk99/wonju-bus', t: '원주 버스', d: '종점 출발 시간을 보려고 만든 시간표 웹·앱. 수집에 실패해도 마지막 정상 시간표로 조회됩니다.' },
	{ href: 'https://github.com/kmsk99/kr-book-info-plugin', t: 'KR Book Info', d: 'Obsidian에 책 정보를 넣어 주는 플러그인. 커뮤니티에서 올라오는 이슈를 계속 고치고 있습니다.' },
	{ href: 'https://github.com/kmsk99/llm-wiki-template', t: 'LLM Wiki Template', d: '원자료·위키·산출물 3단계로 지식을 쌓는 LLM 위키 구조를 템플릿으로 공개했습니다.' },
];
---

<BaseLayout title="소개와 경력" description="제이에이치핏 CTO 김민석의 경력, 일하는 방식, 연구와 기술">
	<div class="wrap about-grid">
		<aside class="about-side">
			<img src="/images/mason-avatar.png" alt="안경과 초록색 후드 차림의 김민석 캐리커처" width="120" height="120" />
			<h1>김민석</h1>
			<p>Mason Kim · 제이에이치핏 CTO</p>
			<ul>
				<li>
					<a href="mailto:kmsk96@naver.com"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>kmsk96@naver.com</a>
				</li>
				<li>
					<a href="https://www.linkedin.com/in/kmsk99/" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"></path></svg>LinkedIn</a>
				</li>
				<li>
					<a href="https://github.com/kmsk99" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 19c-4 1.5-4-2-6-2.5M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"></path></svg>GitHub</a>
				</li>
				<li>
					<a href="/documents/mason-kim-resume.pdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M12 18v-6M9 15l3 3 3-3"></path></svg>이력서 PDF</a>
				</li>
				<li>
					<a href="/documents/mason-kim-portfolio.pdf"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M12 18v-6M9 15l3 3 3-3"></path></svg>포트폴리오 PDF</a>
				</li>
			</ul>
		</aside>

		<div class="about-main">
			<section aria-labelledby="intro-title">
				<h2 id="intro-title" class="sr-only">소개</h2>
				<p class="about-lede">
					고객과 기획자의 요구를 업무 규칙과 제품으로 구체화하는 CTO입니다. 웹·모바일부터 백엔드, 데이터, 클라우드
					운영까지 함께 맡고, 구현한 뒤에는 실제 데이터와 실행 결과로 동작을 확인합니다.
				</p>
				<p class="about-lede">
					포트존에서 4인 팀을 이끌며 서비스 3개로 누적 가입자 22,000명 이상을 모았고, 콘치즈에서 사장링크와 전산
					자동화를 맡았습니다. 지금은 제이에이치핏에서 핏브릿지를 만듭니다. 그 사이 금융 수치 추론 RAG를 연구해 2026년
					8월 공학석사 학위를 받았습니다.
				</p>
			</section>

			<section aria-labelledby="how-title">
				<h2 id="how-title">일하는 방식</h2>
				<ul class="principles">
					{principles.map((p) => (
						<li>
							<strong>{p.t}</strong>
							<span>{p.d}</span>
						</li>
					))}
				</ul>
			</section>

			<section aria-labelledby="roles-title">
				<h2 id="roles-title">회사별로 한 일</h2>
				{roles.map((r) => (
					<details class="role" data-tone={r.tone} open={r.open}>
						<summary>
							<h3>
								<span class="dot"></span>
								{r.org} · {r.title}
							</h3>
							<span class="when">{r.when}</span>
							<p>{r.sub}</p>
							<Fragment set:html={chev} />
						</summary>
						<div class="role__body">
							<p>{r.lede}</p>
							{r.points.length > 0 && (
								<ul>
									{r.points.map((p) => (
										<li>{p}</li>
									))}
								</ul>
							)}
							{r.note && <p class="note">{r.note}</p>}
						</div>
					</details>
				))}
			</section>

			<section aria-labelledby="research-title">
				<h2 id="research-title">연구</h2>
				<div class="thesis">
					<h3>서강대학교 AI·SW대학원 공학석사</h3>
					<p style="color:var(--muted); font-size:.875rem; margin-top:4px">데이터사이언스·인공지능 · 2023.03–2026.08</p>
					<q>금융 수치 추론을 위한 RAG에서 검색 품질에 따른 반복 검색 효과와 잔여 오류 분해</q>
					<p>
						금융 보고서의 표와 텍스트를 검색하고, FinQA에 맞춘 재순위화와 Program-of-Thought, 동적 few-shot으로
						답을 계산하는 파이프라인을 만들었습니다. 작은 모델의 검색 정책을 프롬프트·SFT·강화학습으로 비교하고, 검색
						품질이 높을 때는 반복 검색의 이득이 뚜렷하지 않다는 점과 그 뒤에 남는 오류를 나눠 분석했습니다.
					</p>
					<ul class="metrics">
						<li><strong>82.48%</strong>FinQA 테스트 실행 정확도</li>
						<li><strong>1,147</strong>평가 문항</li>
						<li><strong>Kimi-K2.5</strong>생성 모델</li>
					</ul>
				</div>
			</section>

			<section aria-labelledby="stack-title">
				<h2 id="stack-title">쓰는 기술</h2>
				<dl class="stack">
					{stack.map((s) => (
						<>
							<dt>{s.k}</dt>
							<dd>
								{s.v.map((v) => (
									<span class="tag">{v}</span>
								))}
							</dd>
						</>
					))}
				</dl>
			</section>

			<section aria-labelledby="side-title">
				<h2 id="side-title">직접 쓰려고 만든 것</h2>
				<div class="side-projects">
					{sides.map((s) => (
						<a href={s.href} target="_blank" rel="noreferrer">
							<strong>{s.t}</strong>
							<span>{s.d}</span>
						</a>
					))}
				</div>
			</section>

			<section aria-labelledby="facts-title">
				<h2 id="facts-title">수상·자격·학력</h2>
				<ul class="facts">
					{facts.map((f) => (
						<li>
							{f.k}
							<span>{f.v}</span>
						</li>
					))}
				</ul>
			</section>
		</div>
	</div>
</BaseLayout>

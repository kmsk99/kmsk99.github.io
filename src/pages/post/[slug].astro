---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAllItems, type Item } from '../../lib/content';

export async function getStaticPaths() {
	const items = await getAllItems();
	const seen = new Set<string>();
	const paths: { params: { slug: string }; props: { item: Item } }[] = [];

	for (const item of items) {
		if (!item.slug || seen.has(item.slug)) continue;
		seen.add(item.slug);
		paths.push({ params: { slug: item.slug }, props: { item } });
		// 예전 .md 링크 호환 경로
		if (item.entry.id.endsWith('.md')) paths.push({ params: { slug: `${item.slug}.md` }, props: { item } });
	}

	return paths;
}

const { item } = Astro.props;
---

<ArticleLayout item={item} />

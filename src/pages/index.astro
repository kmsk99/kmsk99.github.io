---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import Feed from '../components/Feed.astro';
import { getAllItems } from '../lib/content';

const items = await getAllItems();

// 2026년 10월에 공개한 개발 사례. 이미지가 있는 글을 앞에 둔다.
const featuredSlugs = [
	'business-rules-ontology',
	'store-profit-data-reconciliation',
	'concurrent-refund-integrity-testing',
	'body-composition-extraction-evaluation',
	'grant-review-workflow-automation',
	'three-services-deployment-and-review',
];
const images: Record<string, string> = {
	'business-rules-ontology': '/images/case-studies/ai-engineering-editorial.png',
	'store-profit-data-reconciliation': '/images/case-studies/data-reconciliation-editorial.png',
};
const featured = featuredSlugs.map((s) => items.find((i) => i.slug === s)).filter((i) => i !== undefined);
---

<BaseLayout>
	<div class="wrap">
		<section class="hero">
			<div class="hero__intro">
				<div class="hero__who">
					<img src="/images/mason-avatar.png" alt="안경과 초록색 후드 차림의 김민석 캐리커처" width="64" height="64" />
					<div>
						<strong>김민석 · Mason Kim</strong>
						<span>제이에이치핏 CTO, 제품 개발 리드</span>
					</div>
				</div>
				<h1>업무 규칙을 제품으로 옮기고, 실제 데이터로 확인합니다</h1>
				<p class="hero__lede">
					피트니스 센터 운영 SaaS 핏브릿지를 만들고 있습니다. 포트존에서는 서비스 3개를 운영하며 누적 가입자
					22,000명을 모았고, 금융 RAG 연구로 석사 학위를 받았습니다. 여기에는 그 과정에서 부딪힌 문제와 푼 방법을
					기록합니다.
				</p>
				<div class="hero__actions">
					<a class="btn btn--primary" href="#feed">글 {items.length}편 둘러보기</a>
					<a class="btn" href="/about/">경력 보기</a>
					<a class="btn" href="/documents/mason-kim-resume.pdf">이력서 PDF</a>
				</div>
				<p class="status"><span class="dot"></span>2026년 10월, 핏브릿지 개발 중</p>
			</div>
			<KnowledgeGraph />
		</section>

		<section class="section" aria-labelledby="now-title">
			<div class="section-head">
				<div>
					<h2 id="now-title">지금 하는 일</h2>
				</div>
			</div>
			<div class="now">
				<div class="now__item">
					<span class="where">제이에이치핏 · CTO</span>
					<h3>센터 운영 SaaS</h3>
					<p>
						회원·수강권·예약·결제·정산을 다루는 관리자 웹과 회원·코치 앱을 하나의 API로 묶습니다. 기존 센터 데이터
						이관과 권한, 동시성 문제를 함께 맡습니다.
					</p>
				</div>
				<div class="now__item">
					<span class="where">AI 개발 하네스</span>
					<h3>AI가 짠 코드를 규칙에 대조하기</h3>
					<p>
						업무 규칙을 온톨로지로 적고, 실제 DB 경합·장애 주입·변이 테스트로 AI 보조 구현을 검증합니다. 금액 규칙의
						변이 탐지는 59/73에서 71/73으로 올라갔습니다.
					</p>
				</div>
				<div class="now__item">
					<span class="where">개인 지식 시스템</span>
					<h3>근거가 남는 LLM 위키</h3>
					<p>
						프로젝트 기록과 결정을 원자료·위키·산출물 3단계로 쌓아 여러 코딩 에이전트가 같은 근거를 씁니다. 구조는
						<a class="text-link" href="https://github.com/kmsk99/llm-wiki-template" target="_blank" rel="noreferrer">템플릿으로 공개</a>했습니다.
					</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="career-title">
			<div class="section-head">
				<div>
					<h2 id="career-title">경력</h2>
					<p>막대를 누르면 그 시기에 한 일이 열립니다. 2026년은 일이 겹쳐 넓게 그렸습니다.</p>
				</div>
				<a class="text-link" href="/about/">전체 경력과 기술</a>
			</div>
			<CareerTimeline />
		</section>

		<section class="section" aria-labelledby="cases-title">
			<div class="section-head">
				<div>
					<h2 id="cases-title">개발 사례</h2>
					<p>최근 프로젝트에서 실제로 부딪힌 문제 여섯 개를 회사·고객 정보를 지우고 정리했습니다.</p>
				</div>
			</div>
			<div class="cases">
				{featured.map((i) => (
					<article class="case" data-tone={i.category.tone}>
						{images[i.slug] && (
							<div class="case__img">
								<img src={images[i.slug]} alt="" loading="lazy" decoding="async" />
							</div>
						)}
						<div class="case__meta">
							<span class="dot"></span>
							{i.category.label}
							<span aria-hidden="true">·</span>
							{i.minutes}분
						</div>
						<h3>
							<a href={i.url}>{i.title}</a>
						</h3>
						{i.summary && <p>{i.summary}</p>}
					</article>
				))}
			</div>
		</section>

		<section class="section" id="feed" aria-labelledby="feed-title">
			<div class="section-head">
				<div>
					<h2 id="feed-title">모든 기록</h2>
					<p>그래프의 카테고리를 누르거나 아래에서 바로 걸러 보세요. 어디서든 ⌘K로 검색할 수 있습니다.</p>
				</div>
				<a class="text-link" href="/rss.xml">RSS 구독</a>
			</div>
			<Feed items={items} showKinds showCategories placeholder="제목, 요약, 태그로 찾기" />
		</section>
	</div>
</BaseLayout>

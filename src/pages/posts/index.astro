---
import ListPage from '../../components/ListPage.astro';
import { getAllItems } from '../../lib/content';

const items = (await getAllItems()).filter((i) => i.kind === 'post');
---

<ListPage
	title="기술 글"
	heading="기술 글"
	lede="제품을 만들고 운영하며 직접 겪은 문제를 적었습니다. 왜 그렇게 결정했는지와 무엇을 확인했는지를 함께 남깁니다."
	items={items}
/>

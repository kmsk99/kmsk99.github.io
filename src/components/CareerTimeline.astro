---
// 2026년에 일이 몰려 있어 축을 구간별로 늘린다. [연도, 위치%]
const STOPS: [number, number][] = [
	[2019, 0],
	[2023, 20],
	[2026, 60],
	[2027, 100],
];
const pos = (y: number) => {
	for (let i = 1; i < STOPS.length; i++) {
		const [y0, p0] = STOPS[i - 1];
		const [y1, p1] = STOPS[i];
		if (y <= y1) return p0 + ((y - y0) / (y1 - y0)) * (p1 - p0);
	}
	return 100;
};
const NOW = 2026 + 9.5 / 12;
const ym = (y: number, m: number) => y + (m - 1) / 12;

interface Role {
	id: string;
	lane: number;
	label: string;
	from: number;
	to: number;
	tone: string;
	title: string;
	when: string;
	lede: string;
	metrics?: { value: string; label: string }[];
	points: string[];
}

const roles: Role[] = [
	{

			'업무 규칙을 Turtle/OWL·SHACL·SPARQL 온톨로지로 표현해 코드·DB·테스트 근거와 연결',
			'환불·리워드·인증의 동시성 문제를 실제 PostgreSQL 경합과 장애 주입으로 재현하고 수정',
			'API 계약에서 TypeScript·Dart 클라이언트를 생성하고 AWS 배포와 오류 추적을 자동화',
		],
	},
	{
		id: 'grad',
		lane: 2,
		label: '서강대 AI·SW대학원',
		from: ym(2023, 3),
		to: ym(2026, 9),
		tone: 'oss',
		title: '서강대학교 AI·SW대학원 · 공학석사',
		when: '2023.03–2026.08 · 데이터사이언스·인공지능',
		lede: '회사 일을 하면서 금융 수치 추론 RAG를 연구해 학위를 받았습니다.',
		metrics: [
			{ value: '82.48%', label: 'FinQA 테스트 실행 정확도' },
			{ value: '1,147', label: '평가 문항' },
		],
		points: [
			'금융 표·텍스트 검색, 재순위화, Program-of-Thought, 반복 검색을 비교 평가',
			'검색 품질이 높을 때 반복 검색의 효과가 줄어드는 조건과 남는 오류를 분해',
		],
	},
];

const ticks = [2019, 2021, 2023, 2024, 2025, 2026];
const initial = 'jhfit';
---

<div class="timeline" data-timeline>
	<div class="timeline__track">
		<div class="timeline__grid" style="--lanes-h: 160px">
			<div class="timeline__years" aria-hidden="true">
				{ticks.map((y) => <span style={`left:${pos(y)}%`}>{y}</span>)}
				<span style={`left:${pos(NOW)}%; color: var(--accent); font-weight: 700`}>지금</span>
			</div>
			<div role="tablist" aria-label="경력 구간" data-tablist>
				{[0, 1, 2].map((lane) => (
					<div class="timeline__lane" role="presentation">
						{roles
							.filter((r) => r.lane === lane)
							.map((r) => (
								<button
									class="timeline__bar"
									type="button"
									role="tab"
									id={`tab-${r.id}`}
									aria-controls={`panel-${r.id}`}
									aria-selected={String(r.id === initial)}
									tabindex={r.id === initial ? 0 : -1}
									data-tone={r.tone}
									style={`left:${pos(r.from)}%; width:${pos(r.to) - pos(r.from)}%`}
								>
									<span class="dot"></span>
									{r.label}
								</button>
							))}
					</div>
				))}
			</div>
		</div>
	</div>
	<div class="timeline__detail">
		{roles.map((r) => (
			<div
				class="timeline__panel"
				role="tabpanel"
				id={`panel-${r.id}`}
				aria-labelledby={`tab-${r.id}`}
				data-tone={r.tone}
				hidden={r.id !== initial}
			>
				<header>
					<h3>{r.title}</h3>
					<p>{r.when}</p>
				</header>
				<div class="timeline__body">
					<p>{r.lede}</p>
					{r.metrics && (
						<ul class="metrics">
							{r.metrics.map((m) => (
								<li>
									<strong>{m.value}</strong>
									{m.label}
								</li>
							))}
						</ul>
					)}
					<ul>
						{r.points.map((p) => (
							<li>{p}</li>
						))}
					</ul>
				</div>
			</div>
		))}
	</div>
</div>

<script>
	import { onPage } from '../lib/page';

	onPage(() => document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((root) => {
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')].sort(
			(a, b) => parseFloat(a.style.left) - parseFloat(b.style.left),
		);
		const select = (tab: HTMLButtonElement, focus = false) => {
			tabs.forEach((t) => {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!;
				panel.hidden = !on;
			});
			if (focus) tab.focus();
			tab.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
		};
		// 좁은 화면에서는 선택된 최근 경력이 보이도록 트랙을 오른쪽 끝으로 옮긴다.
		const track = root.querySelector<HTMLElement>('.timeline__track');
		if (track) track.scrollLeft = track.scrollWidth;
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => select(t));
			t.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
					e.preventDefault();
					select(tabs[(i + 1) % tabs.length], true);
				} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
					e.preventDefault();
					select(tabs[(i - 1 + tabs.length) % tabs.length], true);
				}
			});
		});
	}));
</script>

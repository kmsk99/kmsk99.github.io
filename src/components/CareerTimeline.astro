		lane: 0,
		label: '육군 중위',
		from: ym(2019, 3),
		to: ym(2021, 7),
		tone: 'retro',
		title: '대한민국 육군',
		when: '2019–2021 · 중위, 화생방 소대장',
		lede: '30명 규모 소대를 지휘하고 훈련을 운영했습니다.',
